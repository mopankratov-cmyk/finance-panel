# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# claude code: делимся командным конфигом (agents/settings/launch), но НЕ локальным.
# Скиллы НЕ коммитим симлинками (ломаются на Windows) — их разворачивает scripts/setup-claude.mjs
# из .agents/skills (тот каталог трекается). settings.local.json / sessions / worktrees / skills — локальные.
/.claude/*
!/.claude/agents/
!/.claude/settings.json
!/.claude/launch.json
.gstack/

# openreels: тяжёлые тестовые медиа-инпуты v0-v9 (46MB видео) — локальные, не в git.
# После V23 шаблон Remotion на пропсах → ассеты динамические из брифа; эти mp4 в проде не нужны.
/public/reel-assets/

# финансы: выгрузки ДДС (csv в корне проекта) — живые финансовые данные, НЕ в git.
# Импорт идёт через кнопку «Импорт ДДС» (читает файл с компьютера), git для этого не нужен.
# Узко: только корень проекта — законные csv во вложенных папках (.agents, docs) не затрагиваются.
/*.csv
.tmp-review/
