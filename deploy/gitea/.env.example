# Скопируй в .env и заполни (для локального docker compose). На Railway эти же значения
# задаются в переменных окружения соответствующих сервисов. .env в git НЕ коммитим.

# Пароль БД Gitea (придумай длинный, одинаковый для gitea и db)
GITEA_DB_PASSWORD=

# Публичный URL инстанса (локально http://localhost:3000; на Railway — выданный домен https://...)
GITEA_ROOT_URL=http://localhost:3000

# Токен регистрации раннера: Gitea → Site Admin → Actions → Runners → Create registration token.
# Заполняется ПОСЛЕ первого старта Gitea (когда инстанс уже поднят).
RUNNER_TOKEN=
