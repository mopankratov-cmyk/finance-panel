# Шаблон переменных форжа. На VM: cp env.sample .env  && заполнить. .env в git НЕ коммитим.
# (Назван env.sample, а не .env.example, чтобы не путать с секрет-файлами .env*)

# Домен форжа. Свой домен → A-запись на IP VM. Нет домена → sslip.io:
#   GITEA_DOMAIN=gitea.<IP-через-дефис>.sslip.io     (напр. gitea.51-250-1-2.sslip.io)
GITEA_DOMAIN=

# E-mail для Let's Encrypt (уведомления об истечении сертификата)
ACME_EMAIL=

# Пароль БД Gitea (длинный; используется и gitea, и db)
GITEA_DB_PASSWORD=

# Токен регистрации раннера: Gitea → Site Admin → Actions → Runners → Create registration token.
# Заполняется ПОСЛЕ первого старта Gitea (когда инстанс уже поднят).
RUNNER_TOKEN=
