{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PANKSTER Phase 1B Installation Manifest Envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "manifest_state",
    "manifest_content",
    "content_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": "phase1b.installation-manifest.v2"
    },
    "manifest_state": {
      "enum": [
        "TEMPLATE",
        "DRAFT",
        "READY_FOR_REVIEW",
        "APPROVED",
        "EXPIRED",
        "REVOKED"
      ]
    },
    "manifest_content": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "approval_id",
        "backend",
        "backend_version",
        "artifacts",
        "disk_changes",
        "background_services",
        "required_permissions",
        "network_changes",
        "rollback_plan_hash",
        "created_at",
        "expires_at"
      ],
      "properties": {
        "approval_id": {
          "type": "string",
          "pattern": "^p1b-[0-9]{8}-[a-z0-9-]{8,64}$"
        },
        "backend": {
          "const": "apple-container-cli"
        },
        "backend_version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
          "maxLength": 128
        },
        "artifacts": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "$ref": "#/$defs/artifact"
          }
        },
        "disk_changes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/nonAbsenceDisclosureString"
          }
        },
        "background_services": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/nonAbsenceDisclosureString"
          }
        },
        "required_permissions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/nonAbsenceDisclosureString"
          }
        },
        "network_changes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/networkDisclosureString"
          }
        },
        "rollback_plan_hash": {
          "$ref": "#/$defs/sha256"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "expires_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "content_sha256": {
      "$ref": "#/$defs/sha256"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "ociDigest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "boundedString": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[^\\u0000-\\u001f].*[^\\u0000-\\u001f]$|^[^\\u0000-\\u001f]$"
    },
    "nonAbsenceDisclosureString": {
      "allOf": [
        {
          "$ref": "#/$defs/boundedString"
        },
        {
          "not": {
            "enum": [
              "NONE",
              "none",
              "N/A",
              "n/a",
              "NA",
              "na",
              "not applicable",
              "no change",
              "no changes",
              "nothing",
              "unknown",
              "TBD",
              "tbd",
              "to be determined",
              "not known"
            ]
          }
        }
      ]
    },
    "networkDisclosureString": {
      "allOf": [
        {
          "$ref": "#/$defs/boundedString"
        },
        {
          "not": {
            "enum": [
              "none",
              "N/A",
              "n/a",
              "NA",
              "na",
              "not applicable",
              "no change",
              "no changes",
              "nothing",
              "unknown",
              "TBD",
              "tbd",
              "to be determined",
              "not known"
            ]
          }
        }
      ]
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "name",
        "version",
        "source_url",
        "resolved_download_hosts",
        "sha256",
        "size_bytes",
        "signature_type",
        "expected_signer_identity",
        "expected_signer_team_id",
        "notarization_requirement",
        "verification_policy_id"
      ],
      "properties": {
        "role": {
          "enum": [
            "backend-installer",
            "linux-kernel",
            "init-filesystem",
            "synthetic-oci-manifest"
          ]
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "pattern": "^[^/\\\\\\u0000-\\u001f]+$"
        },
        "version": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[^\\s\\u0000-\\u001f]+$"
        },
        "source_url": {
          "type": "string",
          "pattern": "^https://[^\\s\\u0000-\\u001f?#]+/[^\\s\\u0000-\\u001f?#]+$"
        },
        "resolved_download_hosts": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "github.com",
              "objects.githubusercontent.com",
              "release-assets.githubusercontent.com",
              "ghcr.io",
              "registry.k8s.io",
              "europe-west3-docker.pkg.dev"
            ]
          }
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "oci_digest": {
          "$ref": "#/$defs/ociDigest"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "signature_type": {
          "enum": [
            "apple-signed-pkg",
            "sha256-only",
            "oci-digest"
          ]
        },
        "expected_signer_identity": {
          "$ref": "#/$defs/boundedString"
        },
        "expected_signer_team_id": {
          "$ref": "#/$defs/boundedString"
        },
        "notarization_requirement": {
          "enum": [
            "required",
            "not_applicable"
          ]
        },
        "verification_policy_id": {
          "enum": [
            "apple-container-installer-v1",
            "apple-container-release-asset-sha256-v1",
            "oci-manifest-sha256-v1",
            "oci-digest-pinned-v1"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "role": {
                "const": "synthetic-oci-manifest"
              }
            },
            "required": [
              "role"
            ]
          },
          "then": {
            "required": [
              "oci_digest"
            ]
          }
        }
      ]
    }
  }
}
