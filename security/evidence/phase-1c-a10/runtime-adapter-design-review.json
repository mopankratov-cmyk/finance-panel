      "a9_spec_path": "security/evidence/phase-1c-a9/host-side-model-and-credential-broker-spec.json",
      "a9_status": "SPEC_COMPLETE_NO_IMPLEMENTATION_APPROVED"
    },
    "status": "DESIGN_REVIEW_COMPLETE_NO_IMPLEMENTATION_APPROVED"
  },
