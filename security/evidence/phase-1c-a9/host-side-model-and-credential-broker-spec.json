      "model.completed",
      "model.failed",
      "credential.refresh.requested",
      "credential.refresh.completed",
      "credential.refresh.denied",
      "sandbox.destroyed"
    ],
    "components": {
      "audit_sink": {
        "responsibility": "append decision, usage, denial, refresh, revoke, and cleanup events with hashes and no secret values",
        "secret_values_allowed": false
      },
      "credential_broker": {
        "can_refresh_oauth": true,
        "oauth_refresh_policy": "owner_only_compare_and_swap_no_profile_write",
        "responsibility": "hold owner-scoped credential references and issue attempt-scoped non-secret grant references",
        "stores_secret_values": false
      },
      "grant_registry": {
        "grant_reference_secret": false,
        "responsibility": "track grant lifecycle, revocation, replay protection, usage counters, budget, and expiry"
      },
      "model_broker": {
        "responsibility": "execute approved model/provider calls on the host using eligible owner credentials and return sanitized responses plus usage",
        "runs_inside_sandbox": false
      },
      "policy_engine": {
        "responsibility": "validate profile, attempt, provider, model, operation, budget, ttl, network policy, and runtime state before any grant or broker call",
        "stores_secret_values": false
      },
      "runtime_adapter_interface": {
        "implementation_in_a9": false,
        "responsibility": "start sandbox with allowlisted env and forward model/tool requests to host brokers without exposing credentials"
      }
    },
    "created_at": "2026-07-22T23:10:00Z",
    "decision": "HOST_SIDE_MODEL_AND_CREDENTIAL_BROKER_REQUIRED_BEFORE_PRODUCTION_RUNTIME",
    "design_principles": [
      "host_retains_all_real_credentials",
      "sandbox_receives_no_provider_secret_values",
      "grant_references_are_not_bearer_secrets",
      "model_calls_are_host_orchestrated",
      "profile_policy_is_required_before_grant_creation",
      "missing_invalid_policy_fails_closed",
      "all_broker_decisions_are_audited_without_secret_values",
      "default_profile_compatibility_is_explicit_not_inherited_by_named_profiles"
