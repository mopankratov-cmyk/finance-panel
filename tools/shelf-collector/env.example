# Скопируйте в .env (cp env.example .env) и заполните.

# Адрес панели (без завершающего слэша)
PANEL_URL=https://finance-panel-two.vercel.app

# Секрет сборщика: SHELF_CRON_SECRET из env Vercel (свой у сборщика; серверный
# CRON_SECRET панель тоже принимает, но он sensitive и наружу не выгружается)
PANEL_CRON_SECRET=ЗАМЕНИТЬ_НА_SHELF_CRON_SECRET

# true — headless (без окна). По умолчанию false: headless заметно чаще упирается
# в антибот-челлендж WB, чем видимое окно реального Chrome (проверено эмпирически).
HEADLESS=false

# Пауза между артикулами, мс (диапазон, чтобы не долбить WB одинаковыми интервалами)
DELAY_MIN_MS=3000
DELAY_MAX_MS=8000
